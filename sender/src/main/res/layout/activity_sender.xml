<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="otus.gpb.homework.activities.sender.SenderActivity">

    <Button
        android:id="@+id/buttonToGoogleMaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To Google Maps"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="3dp"
        app:layout_constraintBottom_toTopOf="@id/buttonSendEmail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <Button
        android:id="@+id/buttonSendEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Email"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="3dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonOpenReceiver"
        app:layout_constraintTop_toBottomOf="@id/buttonToGoogleMaps"/>

    <Button
        android:id="@+id/buttonOpenReceiver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Receiver"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonSendEmail"/>

</androidx.constraintlayout.widget.ConstraintLayout>